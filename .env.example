# ================================================
# PANTHEON ENVIRONMENT VARIABLES EXAMPLE
# ================================================
# Copy this file to .env and configure for your environment
# Do NOT commit .env file to version control

# ================================================
# APPLICATION SETTINGS
# ================================================
APP_NAME=Pantheon
APP_ENV=development # development, staging, production
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_PORT=3000

# ================================================
# RUST BACKEND SETTINGS
# ================================================
RUST_API_HOST=0.0.0.0
RUST_API_PORT=8000
RUST_API_URL=http://localhost:8000
RUST_LOG_LEVEL=info # trace, debug, info, warn, error

# ================================================
# JWT AUTHENTICATION
# ================================================
JWT_SECRET=YXYlGIbJ65VGjQnETWX23iCvssXg7PJu
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRY=3600 # in seconds (1 hour)
JWT_REFRESH_TOKEN_EXPIRY=604800 # in seconds (7 days)
JWT_ISSUER=pantheon-app
JWT_AUDIENCE=pantheon-users

# ================================================
# DATABASE - CORE (pantheon)
# ================================================
DB_CORE_HOST=localhost
DB_CORE_PORT=5432
DB_CORE_DATABASE=pantheon
DB_CORE_USERNAME=pantheon_user
DB_CORE_PASSWORD=your_secure_password_here
DB_CORE_SCHEMA=public
DB_CORE_POOL_SIZE=10
DB_CORE_MAX_OVERFLOW=20
DB_CORE_SSL_MODE=prefer # disable, allow, prefer, require

# ================================================
# DATABASE - TENANT TEMPLATE
# ================================================
# Tenant databases are created dynamically: pantheon_tenant_{id}
DB_TENANT_HOST=localhost
DB_TENANT_PORT=5432
DB_TENANT_USERNAME=pantheon_tenant_user
DB_TENANT_PASSWORD=your_secure_tenant_password_here
DB_TENANT_POOL_SIZE=5
DB_TENANT_MAX_OVERFLOW=10
DB_TENANT_SSL_MODE=prefer

# ================================================
# DATABASE CONNECTION SETTINGS
# ================================================
DB_CONNECTION_TIMEOUT=30 # seconds
DB_STATEMENT_TIMEOUT=30000 # milliseconds
DB_IDLE_TIMEOUT=600 # seconds
DB_MAX_LIFETIME=1800 # seconds

# ================================================
# RABBITMQ SETTINGS
# ================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=pantheon
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_VHOST=/pantheon
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_CLUSTER_DB_QUEUE=cluster_database_generation

# ================================================
# MQTT SETTINGS (Optional)
# ================================================
MQTT_ENABLED=false
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=pantheon
MQTT_PASSWORD=your_mqtt_password
MQTT_CLIENT_ID=pantheon-backend

# ================================================
# ELASTICSEARCH SETTINGS
# ================================================
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_elasticsearch_password
ELASTICSEARCH_INDEX_PREFIX=pantheon
ELASTICSEARCH_SSL=false

# ================================================
# REDIS SETTINGS (Optional - for caching)
# ================================================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
REDIS_PREFIX=pantheon:

# ================================================
# NUXT FRONTEND SETTINGS
# ================================================
NUXT_PUBLIC_API_BASE=http://localhost:8000/api
NUXT_PUBLIC_APP_NAME=Pantheon
NUXT_PUBLIC_APP_VERSION=1.0.0

# ================================================
# PWA SETTINGS
# ================================================
PWA_ENABLED=true
PWA_NAME=Pantheon App
PWA_SHORT_NAME=Pantheon
PWA_DESCRIPTION=Pantheon Business Management Application
PWA_THEME_COLOR=#1976D2
PWA_BACKGROUND_COLOR=#FFFFFF

# ================================================
# ELECTRON SETTINGS
# ================================================
ELECTRON_ENABLED=false
ELECTRON_APP_ID=com.pantheon.app

# ================================================
# FILE UPLOAD SETTINGS
# ================================================
MAX_UPLOAD_SIZE=10485760 # 10MB in bytes
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx,xls,xlsx
UPLOAD_PATH=./storage/uploads
TEMP_PATH=./storage/temp

# ================================================
# CLUSTER DATABASE SETTINGS
# ================================================
CLUSTER_AUTO_GENERATION_ENABLED=true
CLUSTER_GENERATION_DAYS_BEFORE=5
CLUSTER_CATEGORIES=cashier,scm
CLUSTER_BY_YEAR=true
CLUSTER_BY_MONTH=false # Set to true for monthly clusters

# ================================================
# MULTI-TENANT SETTINGS
# ================================================
TENANT_DB_PREFIX=pantheon_tenant_
TENANT_SCHEMA_PREFIX=
DEFAULT_TENANT_ID=1
AUTO_CREATE_TENANT_DB=true
AUTO_RUN_TENANT_MIGRATIONS=true

# ================================================
# SWAGGER/API DOCUMENTATION
# ================================================
SWAGGER_ENABLED=true
SWAGGER_UI_PATH=/api/docs
SWAGGER_JSON_PATH=/api/docs/swagger.json
SWAGGER_TITLE=Pantheon API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=Pantheon Business Management API Documentation

# ================================================
# CORS SETTINGS
# ================================================
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-Tenant-ID
CORS_CREDENTIALS=true
CORS_MAX_AGE=3600

# ================================================
# RATE LIMITING
# ================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000 # 1 minute
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# ================================================
# LOGGING SETTINGS
# ================================================
LOG_LEVEL=info # trace, debug, info, warn, error
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/pantheon.log
LOG_FILE_MAX_SIZE=10485760 # 10MB
LOG_FILE_MAX_FILES=10
LOG_TO_ELASTICSEARCH=true

# ================================================
# EMAIL SETTINGS (Optional)
# ================================================
MAIL_ENABLED=false
MAIL_DRIVER=smtp # smtp, sendmail, mailgun, etc.
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=tls # tls, ssl
MAIL_FROM_ADDRESS=noreply@pantheon.app
MAIL_FROM_NAME=Pantheon App

# ================================================
# TIMEZONE & LOCALIZATION
# ================================================
TIMEZONE=Asia/Jakarta
DEFAULT_LOCALE=id
SUPPORTED_LOCALES=id,en

# ================================================
# SESSION SETTINGS
# ================================================
SESSION_DRIVER=cookie # cookie, redis, database
SESSION_LIFETIME=120 # minutes
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false # Set true in production with HTTPS

# ================================================
# SECURITY SETTINGS
# ================================================
BCRYPT_ROUNDS=12
HASH_ALGORITHM=bcrypt
ENCRYPTION_KEY=base64:your_32_character_encryption_key_here
FORCE_HTTPS=false # Set true in production

# ================================================
# MONITORING & METRICS
# ================================================
METRICS_ENABLED=false
METRICS_PORT=9090
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# ================================================
# DOCKER SETTINGS
# ================================================
DOCKER_NETWORK=pantheon_network
COMPOSE_PROJECT_NAME=pantheon

# ================================================
# CI/CD SETTINGS
# ================================================
CI_ENABLED=false
GITHUB_REPOSITORY=your-username/pantheon
GITHUB_BRANCH=develop
DEPLOY_ENVIRONMENT=development

# ================================================
# BACKUP SETTINGS
# ================================================
BACKUP_ENABLED=false
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * * # Daily at 2 AM (cron format)

# ================================================
# FEATURE FLAGS
# ================================================
FEATURE_MULTI_TENANT=true
FEATURE_CLUSTER_DB=true
FEATURE_ELASTICSEARCH=true
FEATURE_RABBITMQ=true
FEATURE_MQTT=false
FEATURE_PWA=true
FEATURE_ELECTRON=false

# ================================================
# DEVELOPMENT SETTINGS
# ================================================
DEV_HOT_RELOAD=true
DEV_SOURCE_MAPS=true
DEV_MOCK_DATA=false
DEV_SEED_DATABASE=false

# ================================================
# TESTING SETTINGS
# ================================================
TEST_DATABASE=pantheon_test
TEST_TENANT_DATABASE=pantheon_tenant_test
TEST_PARALLEL=true
TEST_COVERAGE=true

# ================================================
# PERFORMANCE SETTINGS
# ================================================
CACHE_ENABLED=true
CACHE_TTL=3600 # seconds
QUERY_CACHE_ENABLED=true
COMPRESSION_ENABLED=true
MINIFY_ENABLED=true

# ================================================
# THIRD-PARTY INTEGRATIONS (Optional)
# ================================================
PAYMENT_GATEWAY_ENABLED=false
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_SECRET=

SMS_GATEWAY_ENABLED=false
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER=

# ================================================
# CUSTOM BUSINESS SETTINGS
# ================================================
# Pantheon Business
BUSINESS_MAX_PRODUCTS=unlimited
BUSINESS_MAX_FRANCHISES=unlimited
BUSINESS_MAX_EMPLOYEES=unlimited

# Pantheon HQ
HQ_SAAS_ENABLED=true
HQ_AUTO_PROVISIONING=true
HQ_TRIAL_DAYS=14

# ================================================
# NOTES
# ================================================
# 1. Always keep .env.example updated when adding new variables
# 2. Use strong passwords in production
# 3. Enable SSL/TLS in production
# 4. Set DEBUG=false in production
# 5. Use environment-specific values for each deployment
# 6. Store sensitive values in secure vault in production
# 7. Review security settings before going to production
